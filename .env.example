# Set these values only on your own computer or hosting service. Never commit .env.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=choose-a-long-unique-password
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Frontend only: set this in the hosting service when publishing the React app.
# Example: https://meshek32-api.onrender.com/api
VITE_API_URL=http://127.0.0.1:8080/api

# Production PostgreSQL values (used with Spring profile "prod"). In Render,
# use the internal host because the backend is deployed in the same region.
SPRING_PROFILES_ACTIVE=prod
DATABASE_HOST=host
DATABASE_PORT=5432
DATABASE_NAME=meshek32
DATABASE_USERNAME=database-user
DATABASE_PASSWORD=database-password
